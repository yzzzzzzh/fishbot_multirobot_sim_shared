# Frozen from the ROS 1 launch log of the first successful 1000-s single-Go2 run.
# Do not replace these with compose defaults: CONSISTENCY_SIGN must remain +1.0.
LEGGED_COUNT=1
LEGGED_CONTROLLER=rl
LEGGED_RL_MODEL=himloco
LEGGED_AUTO_TROT=false
# These are positive magnitude limits.  Negative values invert clamp bounds and
# force constant lateral/yaw commands in twist_to_control_input.py.
LEGGED_VX_LIMIT=1.2
LEGGED_VY_LIMIT=0.8
LEGGED_WZ_LIMIT=0.8
LEGGED_MAX_LINEAR_ACCEL=1.8
QUADRUPED_WORLD=teaching_building_atrium_legged.world
QUADRUPED_SPAWN_POSES='[[-4.0,0.0,0.46,0.0]]'

RACER_BOTS=1
RACER_AUTO_TRIGGER=true
RACER_ENABLE_TRAJECTORY_SERVER=true
RACER_MAP_WARMUP_SECONDS=8
RACER_PLANNER_MAX_VEL=1.2
RACER_PLANNER_MAX_ACC=0.6
RACER_OBSTACLES_INFLATION=0.85
RACER_EXACT_DRONE_GRID_DIST=40.0
RACER_PARTITIONING_MIN_UNKNOWN_RATIO=0.10
RACER_MIN_TARGET_EXECUTION_TIME=8.0
RACER_CONSISTENCY_SIGN=1.0
RACER_FIRST_GRID_BONUS=6.0
RACER_PARTITIONING_GRID_SIZE=10.0
RACER_PARTITIONING_GRID_SIZE_Z=-1.0
RACER_PARTITIONING_REQUIRE_FRONTIER=false
RACER_PARTITIONING_EXCLUDE_VISITED_NO_FRONTIER=true
RACER_MAP_RESOLUTION=0.25
RACER_MAP_SIZE_X=102.0
RACER_MAP_SIZE_Y=52.0
RACER_MAP_SIZE_Z=0.25
RACER_BOX_MIN_X=-50.0
RACER_BOX_MIN_Y=-25.0
RACER_BOX_MIN_Z=0.50
RACER_BOX_MAX_X=50.0
RACER_BOX_MAX_Y=25.0
RACER_BOX_MAX_Z=0.75
RACER_GROUND_HEIGHT=0.50
RACER_VIRTUAL_CEIL_HEIGHT=0.74
RACER_VISUALIZATION_HEIGHT=0.75
RACER_SENSOR_MODEL=lidar_3d
RACER_MAX_RAY_LENGTH=10.0
RACER_LIDAR_MIN_ELEVATION=-0.02
RACER_LIDAR_MAX_ELEVATION=0.02
RACER_FRONTIER_CLUSTER_MIN=6
RACER_FRONTIER_MIN_VISIB_NUM=5
