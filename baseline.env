RACER_FRONTIER_WALL_GAP_MIN_SUPPORT_CELLS=1
RACER_FRONTIER_WALL_GAP_MAX_CELLS=2
RACER_MIN_TRANSLATION_PROGRESS=0.18
RACER_KINO_MAX_SEARCH_TIME=1.0
RACER_USE_MEASURED_REPLAN_START=true
RACER_EUCLIDEAN_INFLATION=true
