<?xml version="1.0"?>
<!--
  Planar quadruped exploration model.

  The trunk and four legs are rendered explicitly.  Planar locomotion is
  represented by a differential-drive contact proxy under the feet: this
  preserves the non-holonomic (v, yaw-rate) kinematics needed by the RACER
  ground controller without pretending to simulate a learned gait controller.
  Sensing is camera-free: one 3-D lidar and one IMU.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="quadruped_mid360">
  <xacro:arg name="config_file" default="$(find gazebo_sim)/robots/quadruped_mid360/config/quadruped_mid360.yaml"/>
  <xacro:arg name="robot_namespace" default=""/>

  <xacro:property name="config_file" value="$(arg config_file)"/>
  <xacro:property name="cfg" value="${xacro.load_yaml(config_file)}"/>
  <xacro:property name="robot_cfg" value="${cfg['robot']}"/>
  <xacro:property name="geom" value="${cfg['geometry']}"/>
  <xacro:property name="kin" value="${cfg['kinematics']}"/>
  <xacro:property name="mount" value="${cfg['mount']}"/>
  <xacro:property name="plugins" value="${cfg['plugins']}"/>
  <xacro:property name="imu_cfg" value="${cfg['imu']}"/>
  <xacro:property name="lidar_cfg" value="${cfg['lidar']}"/>

  <xacro:property name="ns" value="$(arg robot_namespace)"/>
  <xacro:property name="frame_prefix" value="${ns + '/' if ns != '' else ''}"/>
  <xacro:property name="topic_prefix" value="${'/' + ns if ns != '' else ''}"/>
  <xacro:property name="base_frame" value="${robot_cfg['base_frame']}"/>
  <xacro:property name="lidar_frame" value="${robot_cfg['lidar_frame']}"/>
  <xacro:property name="imu_frame" value="${robot_cfg['imu_frame']}"/>
  <xacro:property name="base_frame_prefixed" value="${frame_prefix + base_frame}"/>
  <xacro:property name="lidar_frame_prefixed" value="${frame_prefix + lidar_frame}"/>
  <xacro:property name="imu_frame_prefixed" value="${frame_prefix + imu_frame}"/>
  <xacro:property name="odom_frame_prefixed" value="${frame_prefix + robot_cfg['odom_frame']}"/>
  <xacro:property name="laser_retro" value="${robot_cfg['laser_retro']}"/>

  <link name="${base_frame}">
    <visual>
      <geometry>
        <box size="${geom['body']['size_x']} ${geom['body']['size_y']} ${geom['body']['size_z']}"/>
      </geometry>
      <material name="dog_trunk"><color rgba="0.12 0.25 0.42 1.0"/></material>
    </visual>
    <collision>
      <geometry>
        <box size="${geom['body']['size_x']} ${geom['body']['size_y']} ${geom['body']['size_z']}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${geom['body']['mass']}"/>
      <inertia ixx="${geom['body']['inertia']['ixx']}" ixy="0" ixz="0"
               iyy="${geom['body']['inertia']['iyy']}" iyz="0"
               izz="${geom['body']['inertia']['izz']}"/>
    </inertial>
  </link>
  <link name="head_link">
    <visual>
      <geometry><box size="0.20 0.25 0.18"/></geometry>
      <material name="dog_head"><color rgba="0.18 0.42 0.68 1.0"/></material>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="head_joint" type="fixed">
    <parent link="${base_frame}"/>
    <child link="head_link"/>
    <origin xyz="0.40 0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- Visible legs are rigid in this navigation-level dynamics model. -->
  <xacro:macro name="visual_leg" params="name x y">
    <link name="${name}_leg_link">
      <visual>
        <origin xyz="0 0 -0.13" rpy="0 0 0"/>
        <geometry><box size="0.075 0.075 0.30"/></geometry>
        <material name="${name}_upper"><color rgba="0.16 0.18 0.22 1.0"/></material>
      </visual>
      <visual>
        <origin xyz="0.055 0 -0.31" rpy="0 0.35 0"/>
        <geometry><box size="0.075 0.075 0.22"/></geometry>
        <material name="${name}_lower"><color rgba="0.08 0.10 0.13 1.0"/></material>
      </visual>
      <visual>
        <origin xyz="0.095 0 -0.42" rpy="0 0 0"/>
        <geometry><sphere radius="0.065"/></geometry>
        <material name="${name}_foot"><color rgba="0.04 0.04 0.04 1.0"/></material>
      </visual>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.0001" ixy="0" ixz="0"
                 iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    <joint name="${name}_leg_joint" type="fixed">
      <parent link="${base_frame}"/>
      <child link="${name}_leg_link"/>
      <origin xyz="${x} ${y} 0.04" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
  <xacro:visual_leg name="front_left"  x="0.24"  y="0.18"/>
  <xacro:visual_leg name="front_right" x="0.24"  y="-0.18"/>
  <xacro:visual_leg name="rear_left"   x="-0.24" y="0.18"/>
  <xacro:visual_leg name="rear_right"  x="-0.24" y="-0.18"/>

  <!-- Differential-drive contact proxy, placed between the visible feet. -->
  <xacro:macro name="drive_wheel" params="name y">
    <link name="${name}">
      <visual>
        <origin rpy="1.570796 0 0"/>
        <geometry>
          <cylinder radius="${geom['wheel']['radius']}" length="${geom['wheel']['width']}"/>
        </geometry>
        <material name="${name}_rubber"><color rgba="0.025 0.025 0.025 0.20"/></material>
      </visual>
      <collision>
        <origin rpy="1.570796 0 0"/>
        <geometry>
          <cylinder radius="${geom['wheel']['radius']}" length="${geom['wheel']['width']}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${geom['wheel']['mass']}"/>
        <inertia ixx="${geom['wheel']['inertia']}" ixy="0" ixz="0"
                 iyy="${geom['wheel']['inertia']}" iyz="0"
                 izz="${geom['wheel']['inertia']}"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="${base_frame}"/>
      <child link="${name}"/>
      <origin xyz="0 ${y} -0.28" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <!-- Give the contact proxy strong rolling traction but low lateral scrub.
         With isotropic default friction, an in-place differential turn spun
         the encoders about 56 degrees farther than the trunk in a 6 minute
         run.  That also injected unnecessary lateral impulses into the IMU.
         fdir1 is the wheel rolling direction in the link frame. -->
    <gazebo reference="${name}">
      <fdir1 value="1 0 0"/>
      <mu1 value="2.0"/>
      <mu2 value="0.20"/>
    </gazebo>
  </xacro:macro>
  <xacro:drive_wheel name="left_drive_wheel" y="0.22"/>
  <xacro:drive_wheel name="right_drive_wheel" y="-0.22"/>

  <xacro:macro name="caster" params="name x">
    <link name="${name}">
      <visual>
        <geometry><sphere radius="${geom['caster']['radius']}"/></geometry>
        <material name="${name}_mat"><color rgba="0.03 0.03 0.03 0.15"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="${geom['caster']['radius']}"/></geometry>
      </collision>
      <inertial>
        <mass value="${geom['caster']['mass']}"/>
        <inertia ixx="0.0001" ixy="0" ixz="0"
                 iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${base_frame}"/>
      <child link="${name}"/>
      <origin xyz="${x} 0 -0.30" rpy="0 0 0"/>
    </joint>
    <gazebo reference="${name}">
      <mu1 value="0.0"/>
      <mu2 value="0.0"/>
    </gazebo>
  </xacro:macro>
  <xacro:caster name="front_caster" x="0.27"/>
  <xacro:caster name="rear_caster" x="-0.27"/>

  <link name="${lidar_frame}">
    <visual>
      <geometry><cylinder radius="0.055" length="0.08"/></geometry>
      <material name="lidar"><color rgba="0.05 0.05 0.05 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.055" length="0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0003" ixy="0" ixz="0"
               iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="${base_frame}"/>
    <child link="${lidar_frame}"/>
    <origin xyz="0 0 ${mount['lidar_z']}" rpy="0 0 0"/>
  </joint>

  <link name="${imu_frame}">
    <visual>
      <geometry><box size="0.025 0.025 0.02"/></geometry>
      <material name="imu"><color rgba="0.8 0.1 0.1 1.0"/></material>
    </visual>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="${base_frame}"/>
    <child link="${imu_frame}"/>
    <origin xyz="0 0 ${mount['imu_z']}" rpy="0 0 0"/>
  </joint>

  <!-- Use one compact passive reflector per robot.  Marking the whole trunk
       as retro-reflective creates two spatially separate high-intensity
       clusters (trunk plus beacon); the temporary Swarm-LIO2 tracker can then
       swap between them and repeatedly discard its excitation history. -->
  <link name="retro_beacon_link">
    <visual>
      <geometry><cylinder radius="0.10" length="0.45"/></geometry>
      <material name="beacon"><color rgba="1.0 0.45 0.02 1.0"/></material>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0"
               iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>
  <joint name="retro_beacon_joint" type="fixed">
    <parent link="${base_frame}"/>
    <child link="retro_beacon_link"/>
    <!-- Keep the beacon on the body rotation axis.  An x/y offset rotates
         through every turn and appears as a non-rigid trajectory residual
         when Swarm-LIO2 aligns the beacon observations to base odometry. -->
    <origin xyz="0 0 0.32" rpy="0 0 0"/>
  </joint>
  <gazebo reference="retro_beacon_link">
    <visual><laser_retro>${laser_retro}</laser_retro></visual>
  </gazebo>

  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
      <odom_publish_frequency>${plugins['diff_drive']['update_rate']}</odom_publish_frequency>
      <left_joint>left_drive_wheel_joint</left_joint>
      <right_joint>right_drive_wheel_joint</right_joint>
      <wheel_separation>${kin['wheel_separation']}</wheel_separation>
      <wheel_radius>${kin['wheel_radius']}</wheel_radius>
      <topic>${topic_prefix}/cmd_vel</topic>
      <odom_topic>${topic_prefix}/${robot_cfg['odom_pub']}</odom_topic>
      <tf_topic>/tf_disabled</tf_topic>
      <odom_frame>${odom_frame_prefixed}</odom_frame>
      <robot_base_frame>${base_frame_prefixed}</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_tf>false</publish_tf>
    </plugin>
  </gazebo>

  <gazebo reference="${imu_frame}">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>${imu_cfg['update_rate']}</update_rate>
      <visualize>${'true' if imu_cfg['visualize'] else 'false'}</visualize>
      <topic>${topic_prefix}/${robot_cfg['imu_pub']}</topic>
      <gz_frame_id>${imu_frame_prefixed}</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>${imu_cfg['noise']['ang_stddev']}</stddev><bias_mean>${imu_cfg['noise']['ang_bias_mean']}</bias_mean><bias_stddev>${imu_cfg['noise']['ang_bias_stddev']}</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>${imu_cfg['noise']['ang_stddev']}</stddev><bias_mean>${imu_cfg['noise']['ang_bias_mean']}</bias_mean><bias_stddev>${imu_cfg['noise']['ang_bias_stddev']}</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>${imu_cfg['noise']['ang_stddev']}</stddev><bias_mean>${imu_cfg['noise']['ang_bias_mean']}</bias_mean><bias_stddev>${imu_cfg['noise']['ang_bias_stddev']}</bias_stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>${imu_cfg['noise']['lin_stddev']}</stddev><bias_mean>${imu_cfg['noise']['lin_bias_mean']}</bias_mean><bias_stddev>${imu_cfg['noise']['lin_bias_stddev']}</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>${imu_cfg['noise']['lin_stddev']}</stddev><bias_mean>${imu_cfg['noise']['lin_bias_mean']}</bias_mean><bias_stddev>${imu_cfg['noise']['lin_bias_stddev']}</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>${imu_cfg['noise']['lin_stddev']}</stddev><bias_mean>${imu_cfg['noise']['lin_bias_mean']}</bias_mean><bias_stddev>${imu_cfg['noise']['lin_bias_stddev']}</bias_stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo reference="${lidar_frame}">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>${lidar_cfg['update_rate']}</update_rate>
      <visualize>${'true' if lidar_cfg['visualize'] else 'false'}</visualize>
      <topic>${topic_prefix}/${robot_cfg['lidar_pub']}</topic>
      <gz_frame_id>${lidar_frame_prefixed}</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>${lidar_cfg['h_rays']['samples']}</samples>
            <resolution>${lidar_cfg['h_rays']['resolution']}</resolution>
            <min_angle>${lidar_cfg['h_rays']['min_angle']}</min_angle>
            <max_angle>${lidar_cfg['h_rays']['max_angle']}</max_angle>
          </horizontal>
          <vertical>
            <samples>${lidar_cfg['v_rays']['samples']}</samples>
            <resolution>${lidar_cfg['v_rays']['resolution']}</resolution>
            <min_angle>${lidar_cfg['v_rays']['min_angle']}</min_angle>
            <max_angle>${lidar_cfg['v_rays']['max_angle']}</max_angle>
          </vertical>
        </scan>
        <range>
          <min>${lidar_cfg['range_min']}</min>
          <max>${lidar_cfg['range_max']}</max>
          <resolution>${lidar_cfg['range_res']}</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>${lidar_cfg['noise_stddev']}</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
</robot>
